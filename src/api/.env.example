# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# --- Google OAuth (required for login) ---
# Create an OAuth client here: https://console.cloud.google.com/apis
# See docs/howto/setup-google-auth.md for step-by-step instructions.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# --- GitHub OAuth (required to link GitHub accounts) ---
# Create an OAuth app here: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:3000/api/ext-accounts/github/callback

# --- Database ---
# Postgres connection string. The postgres:// URL form is required for
# golang-migrate (used by `make migrate-up`). Keep in sync with the
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB values in docker-compose.yml
# (or your local database instance).
DATABASE_URL=postgres://grepdocs:password@localhost:5432/grepdocs?sslmode=disable

# --- Frontend ---
# Base URL of the frontend. Only used for redirects after OAuth flows;
# the API returns "http://localhost:3000" by default when unset.
FRONTEND_URL=http://localhost:3000

# --- App ---
# Set to "production" in production. Controls whether session cookies are
# marked Secure. Empty for local development.
ENV=
# Redis host:port used for the session store. Defaults to localhost:6379
# (the Redis container exposed by docker-compose) when unset.
REDIS_ADDR=localhost:6379

# Master key for enc/dec tokens in the db. Generate it: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=00000000000000000000000000000000000000000000
